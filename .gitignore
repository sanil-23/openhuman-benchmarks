.env
.cache
tasks/generated/
# Raw request captures (full prompts and responses) stay on the bench host.
results/*/captures/
# Built by viewer/build-static.mjs (CI publishes it to GitHub Pages).
site/
# Local-only runs kept off the site (invalid or aborted).
results-archive/
# Compaction dataset checkpoints carry full prompts and tool outputs (built by compaction/extract.mjs).
compaction/data/
__pycache__/

# Build output of profile/ and the bench drivers.
target/
profile/target/
onboarding-stress/ONBOARDING-TEST-RESULTS.md

# Security timing raw evidence and isolated worktrees are local-only.
.security-evidence/
worktrees/
parallelism/generated/
# Parallelism sweep artifacts are kept out of git (large per-run logs); see parallelism/README.md.
results/par-*/
